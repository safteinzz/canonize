{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rules file",
  "type": "object",
  "required": ["title", "format", "sections"],
  "properties": {
    "title": { "type": "string" },
    "intro": { "$ref": "#/$defs/lines" },
    "format": { "type": "object", "required": ["keys", "reading", "writing"] },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "rules"],
        "properties": {
          "section": { "type": "string" },
          "rules": { "$ref": "#/$defs/rules" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lines": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "case", "check", "rule", "exceptions"],
        "properties": {
          "name": { "type": "string" },
          "case": { "type": ["string", "null"] },
          "check": { "type": "array", "items": { "type": "string", "pattern": "\\?$" } },
          "rule": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[^?]*$" } },
          "why": { "type": "string" },
          "examples": { "type": "object", "additionalProperties": { "type": "string" } },
          "exceptions": { "$ref": "#/$defs/lines" }
        },
        "additionalProperties": false
      }
    }
  }
}
